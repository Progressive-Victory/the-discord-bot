{
  "name": "the-discord-bot",
  "version": "4.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://https://github.com/Progressive-Victory/the-discord-bot.git"
  },
  "author": {
    "name": "William Bowen",
    "email": "wbowen@progress.win"
  },
  "bugs": {
    "url": "https://github.com/Progressive-Victory/the-discord-bot/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "pnpm format && node esbuild.config.js",
    "predev": "pnpm build",
    "dev": " node --env-file=.env .",
    "predev-test": "pnpm build",
    "dev-test": "node --env-file=.env.test .",
    "predev-deploy": "pnpm build",
    "dev-deploy": "node --env-file=.env . --deploy",
    "dev-test-deploy": "pnpm predev-deploy && node --env-file=.env.test . --deploy",
    "start": "node . --deploy",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier -w src",
    "doc": "typedoc"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.26.0"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "@sapphire/snowflake": "^3.5.5",
    "@tanstack/query-core": "^5.100.14",
    "chrono-node": "^2.9.1",
    "croner": "^10.0.1",
    "csv-writer": "^1.6.0",
    "discord.js": "^14.26.4",
    "esbuild": "^0.27.4",
    "express": "^5.2.1",
    "luxon": "^3.7.2",
    "ts-transformer-keys": "^0.4.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.19",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.4.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}
